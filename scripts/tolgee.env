tolgee.authentication.enabled=true
tolgee.authentication.registrationsAllowed=false
tolgee.authentication.initialUsername=admin
tolgee.authentication.initialPassword=admin

tolgee.rate-limits.enabled=false

# The OAuth 2.1 endpoints only come up once an issuer resolves, and the CLI client is only registered when a
# redirect URI is configured for it. The port is ignored on a loopback redirect (RFC 8252 section 7.3).
tolgee.back-end-url=http://localhost:22222
tolgee.front-end-url=http://localhost:22222
tolgee.oauth2.cli-redirect-uris[0]=http://127.0.0.1/callback

tolgee.internal.showVersion=true
tolgee.internal.controllerEnabled=true

tolgee.import.createImplicitApiKey=true
tolgee.import.baseLanguageTag=en
